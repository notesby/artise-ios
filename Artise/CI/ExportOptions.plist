 Exports the archive for App Store Connect with Artise's distribution certificate and App Store profiles.
 The .ipa is then uploaded to TestFlight by the workflow.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>85ANUGJ7V2</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>signingCertificate</key>
    <string>Apple Distribution</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>co.artise.app</key>
        <string>Artise App Store</string>
        <key>co.artise.app.nse</key>
        <string>Artise NSE App Store</string>
        <key>co.artise.app.shareextension</key>
        <string>Artise Share App Store</string>
    </dict>
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
